IF ~RandomNum(3,3)~ THEN REPLY ~I love you..~ + love3
IF ~RandomNum(4,2)~ THEN REPLY ~I'm glad you are here.~ + here2
IF ~RandomNum(4,4)~ THEN REPLY ~I'm glad you are here.~ + here4
IF ~HPPercentLT(Myself,90) RandomNum(5,1)~ THEN REPLY ~you are bleeding. Can I help?~ + KKNFhurt1
IF ~HPPercentLT(Myself,90) RandomNum(5,2)~ THEN REPLY ~you are bleeding. Can I help?~ + KKNFhurt2
IF ~HPPercentLT(Myself,90) RandomNum(5,3)~ THEN REPLY ~you are bleeding. Can I help?~ + KKNFhurt3
IF ~HPPercentLT(Myself,90) RandomNum(5,4)~ THEN REPLY ~you are bleeding. Can I help?~ + KKNFhurt4

++ ~I do not know how, but Irenicus cast a spell. He took my soul... I am alright, but we need to get out here.~ DO ~SetGlobal("KKNavarCSoulTalk","LOCALS",2)~ + KKNSoul2e
++ ~Now is not the time to talk, I have to get Imoen out of here.~ DO ~SetGlobal("KKNavarCSoulTalk","LOCALS",2)~ + KKNSoul2d
END

IF ~~ THEN KKNSoul2a

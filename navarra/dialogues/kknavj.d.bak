IF ~AreaCheck("AR1600") Global("NavarBrynnlaw","LOCALS",0)~ THEN REPLY ~Do you know anything about this place?~ + brynn
IF ~AreaCheck("AR1700") !Global("KKMissingWarriors","GLOBAL",5) Global("NavarSmallTeeth","LOCALS",0)~ THEN REPLY ~Do you know anything about this place?~ + small
IF ~AreaCheck("AR1800") Global("NavarNorthForest","LOCALS",0)~ THEN REPLY ~Do you know anything about this place?~ + north
IF ~AreaCheck("AR1900") Global("NavarDruidGrove","LOCALS",0)~ THEN REPLY ~Do you know anything about this place?~ + druid
IF ~AreaCheck("AR2100") Global("NavarUnderdark","LOCALS",0)~ THEN REPLY ~Do you know anything about this place?~ + under
IF ~AreaCheck("AR2200") Global("NavarUstNatha","LOCALS",0)~ THEN REPLY ~Do you know anything about this place?~ + ust
IF ~OR(2) Global("KKNavRomanceActive","GLOBAL",1) Global("KKNavRomanceActive","GLOBAL",2) Global("NavarraChild","LOCALS",0)~ THEN REPLY ~What was your childhood like?~ + child
IF ~Global("KKNavSex","GLOBAL",1) RandomNum(2,1)~ THEN REPLY ~I want you, right now.~ + want2
IF ~Global("KKNavSex","GLOBAL",1) RandomNum(2,2)~ THEN REPLY ~I want you, right now.~ + want2a

= ~(She decides to walk over to him.)~
= ~Would you like some company?~
++ ~I would love some company, as long as it is you.~ DO ~SetGlobal("KKNLovTalk","GLOBAL",23) RealSetGlobalTimer("KKNLovTalkTime","GLOBAL",NAV_TIME)~ + LT11a
++ ~I am a bit tired, but sure, for a few minutes.~ DO ~SetGlobal("KKNLovTalk","GLOBAL",23) RealSetGlobalTimer("KKNLovTalkTime","GLOBAL",NAV_TIME)~ + LT11k
END


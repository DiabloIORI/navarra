++ ~Navarra, I love you dearly, but please stop flirting with me.~ DO ~SetGlobal("KKNavarraFlirtsActive","GLOBAL",0)~ EXIT
++ ~Navarra, there is something wrong with you voice.~ + lateNavFIX
++ ~(Leave Navarra alone.)~
EXIT

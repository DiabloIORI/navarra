IF 
~InParty("KKNavar")
Global("KKNHaetalk","LOCALS",0)
!StateCheck(Myself,CD_STATE_NOTVALID)
!StateCheck("HaerDalis",CD_STATE_NOTVALID)
CombatCounter(0)
!See([ENEMY])
See("KKNavar")
~ THEN ~BHAERDA~ NHaetalk

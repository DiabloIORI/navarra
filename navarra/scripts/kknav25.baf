IF
HotKey(K)
THEN
RESPONSE #100
StartCutSceneMode()
StartCutScene("KKNavFix")
END

IF
  InParty(Myself)
  Global("KKNavarraRomanceActive","GLOBAL",2)
  Global("KKAmaTalk","LOCALS",0)
  Global("KKNavAma","GLOBAL",1)
 !StateCheck(Myself,CD_STATE_NOTVALID)    
  !StateCheck(Player1,CD_STATE_NOTVALID)
  CombatCounter(0)
  !See([ENEMY])
THEN
  RESPONSE #100
  IncrementGlobal("KKAmaTalk","LOCALS",1)
      StartDialogueNoSet(Player1)
END

IF
  InParty(Myself)
  Global("BeginChallenge4","GLOBAL",4)
  Global("KKNavThroneTalk","LOCALS",0)
 !StateCheck(Myself,CD_STATE_NOTVALID)    
  !StateCheck(Player1,CD_STATE_NOTVALID)
  CombatCounter(0)
  !See([ENEMY])
THEN
  RESPONSE #100
  IncrementGlobal("KKNavThroneTalk","LOCALS",1)
      StartDialogueNoSet(Player1)
END

IF
  InParty(Myself)
  Global("KKNavarraRomanceActive","GLOBAL",2)
  Global("KKNavSaradushTalk","LOCALS",0)
 !StateCheck(Myself,CD_STATE_NOTVALID)    
  !StateCheck(Player1,CD_STATE_NOTVALID)
  CombatCounter(0)
  !See([ENEMY])
THEN
  RESPONSE #100
  IncrementGlobal("KKNavSaradushTalk","LOCALS",1)
      StartDialogueNoSet(Player1)
END

IF 
    Global("KKNavarraFlirt2","GLOBAL",0) 
    Global("KKNavarraRomanceActive","GLOBAL",2) 
THEN 
    RESPONSE #100 
        RealSetGlobalTimer("KKNavarraFlirtTimer","GLOBAL",3600) 
        SetGlobal("KKNavarraFlirt2","GLOBAL",1) 
END 

IF 
    InParty(Myself) 
    Global("KKNavarraFlirt2","GLOBAL",1) 
    RealGlobalTimerExpired("KKNavarraFlirtTimer","GLOBAL") 
    !StateCheck(Myself,CD_STATE_NOTVALID) 
    !StateCheck(Player1,CD_STATE_NOTVALID) 
    CombatCounter(0) 
THEN 
    RESPONSE #100 
        SetGlobal("KKNavarraFlirt2","GLOBAL",2) 
END 
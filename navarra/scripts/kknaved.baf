IF
InParty(Myself)
  InParty("Edwin") 
  See("Edwin")
  Global("KKEDRomTalk","GLOBAL",0)
  Global("KKEDRomanceActive","GLOBAL",0)
  OR(2)
Global("RenalJob","GLOBAL",2) 
Global("RenalJob","GLOBAL",3)
Dead("MaeVar")
THEN
  RESPONSE #100
    RealSetGlobalTimer("KKNavEdTimer","GLOBAL",900)
    SetGlobal("KKEDRomanceActive","GLOBAL",1)
    SetGlobal("KKEDRomTalk","GLOBAL",1)
END

IF
 RealGlobalTimerExpired("KKNavEdTimer","GLOBAL")
Global("KKEDRomTalk","GLOBAL",1)
InParty("Edwin")
Gender("Edwin",MALE)
CombatCounter(0)
!AreaType(DUNGEON)
See("Edwin")
!StateCheck("Edwin",CD_STATE_NOTVALID)
!StateCheck(Myself,CD_STATE_NOTVALID)
THEN
  RESPONSE #100 
  SetGlobal("KKEDRomTalk","GLOBAL",2)
  PlaySong(0)
      PlaySound("KKNavarEM")
 StartDialogueNoSet("Edwin")
   END


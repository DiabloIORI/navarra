IF
	Delay(10)
	See(Player1)
	Global("KKNavarSeePC","LOCALS",0)
THEN
	RESPONSE #100
		DisplayStringHead(Myself,~你一定见过她们，她们不会去另一家客栈，因为那家客栈的老板是个男人。~)
		SetGlobal("KKNavarSeePC","LOCALS",1)
END

IF

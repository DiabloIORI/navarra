IF
 Global("KKNavarMatch","GLOBAL",0)
 Gender(Player1,MALE)
  Alignment(Player1,MASK_GOOD) 
  OR(3) 
  Race(Player1,HUMAN) 
  Race(Player1,HALF_ELF) 
  Race(Player1,ELF)
THEN
 RESPONSE #100
  SetGlobal("KKNavarMatch","GLOBAL",1)
  SetGlobal("KKNavarRomanceActive","GLOBAL",1)
  RealSetGlobalTimer("KKNLovTalkTime","GLOBAL",%NAV_TIME%)
  SetGlobal("KKNLovTalk","GLOBAL",1)
END


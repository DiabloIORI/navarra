IF
  True()
THEN
  RESPONSE #100
    CutSceneId("KKNavar")
    SetName(~Navarra~)
SetPlayerSound(Myself,%I never thought I'd say this but, this is too much for me. I could use some assistance.%,MORALE)
SetPlayerSound(Myself,%I am happy to be a part of this group.%,HAPPY)
SetPlayerSound(Myself,%Your actions are starting to annoy me.%,UNHAPPY_ANNOYED)
SetPlayerSound(Myself,%If you continue on this path, I'll have no choice but to leave.%,UNHAPPY_SERIOUS)
SetPlayerSound(Myself,%I have had enough of your foolishness!%,UNHAPPY_BREAKING_POINT)
SetPlayerSound(Myself,%About time you realized who is the better leader here.%,LEADER)
SetPlayerSound(Myself,%Don't you think it's time we stopped to rest? I cannot be expected to be at my best when I'm exhausted.%,TIRED)
SetPlayerSound(Myself,%We have better things to do than stand around all day.%,BORED)
SetPlayerSound(Myself,%Time to die!%,BATTLE_CRY1)
SetPlayerSound(Myself,%Time to spill some blood!%,BATTLE_CRY2)
SetPlayerSound(Myself,%DIE!%,BATTLE_CRY3)
SetPlayerSound(Myself,%Time to die!%,BATTLE_CRY4)
SetPlayerSound(Myself,%You're going to wish you had killed me!%,DAMAGE)
SetPlayerSound(Myself,%If this is to be my end... at least it was in battle.%,DYING)
SetPlayerSound(Myself,%A little help here please, I've been wounded.%,HURT)
SetPlayerSound(Myself,%This is paradise! I could live here forever.%,AREA_FOREST)
SetPlayerSound(Myself,%I'll never get used to filthy, foul smelling cities.%,AREA_CITY)
SetPlayerSound(Myself,%I hope you don't plan on being down here long, I prefer being able to see my enemies coming... outside.%,AREA_DUNGEON)
SetPlayerSound(Myself,%Ah, another fine day! So much nicer than the wasteland I used to call home.%,AREA_DAY)
SetPlayerSound(Myself,%It isn't safe to travel at night, there are things out there that can kill you before you see it coming.%,AREA_NIGHT)
SetPlayerSound(Myself,%What?%,SELECT_COMMON1)
SetPlayerSound(Myself,%What do you want?%,SELECT_COMMON2)
SetPlayerSound(Myself,%I suppose I have no choice.%,SELECT_COMMON3)
SetPlayerSound(Myself,%What do you want now?%,SELECT_COMMON4)
SetPlayerSound(Myself,%Yes?%,SELECT_COMMON5)
SetPlayerSound(Myself,%I hear you, I just don't care to be ordered around.%,SELECT_COMMON6)
SetPlayerSound(Myself,%Whatever.%,SELECT_ACTION1)
SetPlayerSound(Myself,%Sure.%,SELECT_ACTION2)
SetPlayerSound(Myself,%I suppose doing it yourself never occurred to you.%,SELECT_ACTION3)
SetPlayerSound(Myself,%If it must be done.%,SELECT_ACTION4)
SetPlayerSound(Myself,%Not hard at all.%,SELECT_ACTION5)
SetPlayerSound(Myself,%Fine! You won't leave me alone until I do.%,SELECT_ACTION6)
SetPlayerSound(Myself,%Do I look like a slave to you?%,SELECT_ACTION7)
SetPlayerSound(Myself,%I'm ready.%,SELECT_RARE1)
SetPlayerSound(Myself,%Yeah, yeah. I'm going.%,SELECT_RARE2)
SetPlayerSound(Myself,%I just love the smell of blood!%,CRITICAL_HIT)
SetPlayerSound(Myself,%You're going to die anyway, so you might as well stop avoiding it.%,CRITICAL_MISS)
SetPlayerSound(Myself,%Is a decent weapon too much to ask?%,TARGET_IMMUNE)
SetPlayerSound(Myself,%Carry your own junk. I am a highly skilled warrior, not a slave.%,INVENTORY_FULL)
SetPlayerSound(Myself,%Navarra gazes at you suspiciously for a moment before she decides to speak. "I was born in Narfell, a cold frigid country inhabited by many tribes of human Barbarians, and not much else. That is all you need to know for now, maybe in time I will reveal more."%,EXISTANCE5)
    EndCutSceneMode()
END
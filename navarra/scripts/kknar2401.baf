IF
Global("KKNavarJoined","GLOBAL",1)
Global("KKShaelExists","AR2401",0)
THEN
RESPONSE #100
SetGlobal("KKShaelExists","AR2401",1)
CreateCreature("KKShael",[253.751],14)
END

IF
	Delay(10)
	See(Player1)
	See("KKNavar")
	Global("KKShaelSeePC","LOCALS",0)
THEN
	RESPONSE #100
		DisplayStringHead(Myself,~纳瓦拉！~)
		SetGlobal("KKShaelSeePC","LOCALS",1)
END
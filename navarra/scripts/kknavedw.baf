IF 
RealGlobalTimerExpired("KKNavEdTimer","GLOBAL")
InParty("Edwin")
See("Edwin")
Gender("Edwin",FEMALE)
!StateCheck("Edwin",STATE_SLEEPING) 
Global("KKEDWoman","GLOBAL",0)
!Global("KKEDSex","GLOBAL",1)
THEN
  RESPONSE #100
  RealSetGlobalTimer("KKNavEdTimer","GLOBAL",900)
  SetGlobal("KKEDWoman","GLOBAL",1)
 END 

IF
RealGlobalTimerExpired("KKNavEdTimer","GLOBAL")
    InParty(Myself)  
    InParty("Edwin") 
    Gender("Edwin",FEMALE)
    Global("KKEDWoman","GLOBAL",1)
    !StateCheck("Edwin",CD_STATE_NOTVALID) 
       !StateCheck("KKNavar",CD_STATE_NOTVALID) 
    !StateCheck(Player1,CD_STATE_NOTVALID)
    CombatCounter(0)
    !See([ENEMY])
THEN
    RESPONSE #100
    SetGlobal("KKEDWoman","GLOBAL",2)
     StartDialogueNoSet("KKNavar")
END
   

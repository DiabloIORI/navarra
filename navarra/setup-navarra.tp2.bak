        ~NAVARRA/Scripts/KKAmana.baf~
        ~NAVARRA/Scripts/KKTress.baf~
        ~NAVARRA/Scripts/KKCelin.baf~
        ~NAVARRA/Scripts/KKDelia.baf~
        ~NAVARRA/Scripts/KKShael.baf~
        ~NAVARRA/Scripts/KKShael2.baf~
        ~NAVARRA/Scripts/KKNavd.baf~
        ~NAVARRA/Scripts/KKAman01.baf~
        ~NAVARRA/Scripts/KKNAR0809.baf~
        ~NAVARRA/Scripts/KKNar0500.baf~
        ~NAVARRA/Scripts/KKNar1700.baf~ 
        ~NAVARRA/Scripts/KKNAR0709.baf~
        ~NAVARRA/Scripts/KKNAR2401.baf~
        ~NAVARRA/Scripts/KKVMPNAV.baf~
        ~NAVARRA/Scripts/KKNavFix.baf~
        
COMPILE ~NAVARRA/Dialogues/KKNav.d~
        ~NAVARRA/Dialogues/KKNavJ.d~
        ~NAVARRA/Dialogues/KKNavB.d~
        ~NAVARRA/Dialogues/KKBarbs.d~
        ~NAVARRA/Dialogues/KKBarbTalk.d~
        ~NAVARRA/Dialogues/KKShael.d~
        ~NAVARRA/Dialogues/kknavrom_ed.d~
        ~NAVARRA/Dialogues/KKVMPNAV.d~   
        
        
EXTEND_TOP ~AR0709.bcs~ ~Navarra/Scripts/KKNAR0709.baf~  
EXTEND_TOP ~AR1700.bcs~ ~Navarra/Scripts/KKNar1700.baf~
EXTEND_TOP ~AR0500.bcs~ ~NAVARRA/Scripts/KKNar0500.baf~
EXTEND_TOP ~AR2401.bcs~ ~NAVARRA/Scripts/KKNar2401.baf~

APPEND ~pdialog.2da~
~KKNavar 	KKNavP 	KKNavJ 	KKNavD 	KKNav25P 	KKNav25J 		KKNav25D 	KKNav25~
UNLESS ~KKNavar~

APPEND ~interdia.2da~
~KKNavar 	KKNavB      KKNav25B~
UNLESS ~KKNavar~

ACTION_IF GAME_IS ~bg2ee~ BEGIN
  COPY ~Navarra/PortraitsEE~ ~override~
END ELSE BEGIN
  COPY ~Navarra/Portraits~ ~override~
END

